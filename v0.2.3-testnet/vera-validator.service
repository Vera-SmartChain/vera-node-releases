[Unit]
Description=VERA SmartChain Validator Node (Testnet)
After=network-online.target
Wants=network-online.target
Conflicts=vera-node.service

[Service]
Type=simple
User=vera
Group=vera
WorkingDirectory=/var/lib/vera
ExecStart=/usr/local/bin/vera_node --data-dir /var/lib/vera/data --genesis /etc/vera/testnet-genesis.json --seed-peers 2.25.216.206:26656 --validator --key-file /etc/vera/validator_key.hex
Restart=always
RestartSec=3
LimitNOFILE=65535

# Strict Security Sandboxing (systemd-analyze security score: 2.1 OK)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/vera
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
PrivateDevices=true
ProtectClock=true
ProtectHostname=true

[Install]
WantedBy=multi-user.target
